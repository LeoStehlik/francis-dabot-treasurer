{
  "name": "@francis/discord-user-tipbot",
  "version": "0.1.0",
  "private": true,
  "description": "Narrow OpenClaw adapter for allowlisted TipBot slash commands through a dedicated Discord user session",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "SECURITY.md",
    "config.example.json"
  ],
  "exports": "./dist/index.js",
  "scripts": {
    "build": "npm run clean:dist && tsc -p tsconfig.json",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "typebox": "1.3.34",
    "undici": "7.30.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "eslint": "9.39.1",
    "openclaw": "2026.9.7",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "openclaw": "2026.9.7"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.9.7",
      "minGatewayVersion": "2026.9.7"
    },
    "build": {
      "openclawVersion": "2026.9.7",
      "pluginSdkVersion": "2026.9.7"
    }
  }
}
